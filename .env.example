# -----------------------------------------------------------------------------
# Museware Environment Variables
# Perfectly mirrors all server & runtime environment variables.
# Configure these in your local .env or in your Vercel Project Settings.
# -----------------------------------------------------------------------------

# 1. House API Key (Server-Side Only)
# Meta AI API key used to power the shared live demo on the deployment.
# Kept strictly server-side — never bundled, exposed to clients, or sent to the browser.
# If omitted or spent, visitors can enter their own temporary key in Settings.
MUSE_API_KEY=

# 2. Base Endpoint URL
# Upstream Meta AI API root endpoint. Both root and /v1 paths are accepted.
# Defaults to https://api.meta.ai
MUSE_BASE_URL=https://api.meta.ai

# 3. Builder Model (Code & Operations)
# The primary model used to apply edit_canvas batches, styling, and structural changes.
# Defaults to muse-spark-1.3
MUSE_CODE_MODEL=muse-spark-1.3

# 4. Chat Model (Conversational Reasoning)
# The model used for conversational turns, clarification, and small talk.
# Defaults to muse-spark-1.3
MUSE_CHAT_MODEL=muse-spark-1.3

# 5. Architect Model (Deep Structural Planning / Wonder Mode)
# The deep-reasoning model invoked during Wonder mode for initial architectural plans.
# Defaults to muse-wonder-1.0
MUSE_ARCHITECT_MODEL=muse-wonder-1.0

# 6. Contributor Model (Testing / Dev Mode)
# Development and testing tier model for experimental ops (requires local DEV mode).
# Defaults to muse-spark-1.3-contributor
MUSE_CONTRIBUTOR_MODEL=muse-spark-1.3-contributor

# 7. Image Generation Model
# Generative image model invoked for hero backgrounds and card illustrations.
# Defaults to muse-image-1.0
MUSE_IMAGE_MODEL=muse-image-1.0

# 8. Maximum Auto-Generated Images
# Ceiling for automatic image generation requests per build turn (default 6, max 30).
MUSE_BUILD_IMAGES=6

# 9. Reasoning Effort Flag
# Set to 1 to transmit Responses-API reasoning effort parameters on the chat surface.
# 0 = disabled (default), 1 = enabled
MUSE_REASONING=0

# 10. House Key Daily Spend Cap (USD per UTC Day)
# Circuit breaker for the server-side house key. At 80% spend, a soft warning is issued;
# at 100%, the house key stops with BUDGET_EXHAUSTED and prompts visitors for their own key.
# Visitors' own pasted keys are never capped by this limit.
# Leave empty for uncapped.
MUSE_DAILY_CAP=5

# 11. Live Production Flag
# Set to 1 on live production deployments (e.g. Vercel) so /api/muse/status reports live: true.
# Local dev and automated CI runs leave this unset or 0.
MUSE_LIVE=1
